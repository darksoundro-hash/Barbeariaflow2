rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Relational checks
    function isBarbershopOwner(shopId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/barbershops/$(shopId)) &&
             get(/databases/$(database)/documents/barbershops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function isMemberOfShop(shopId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId == shopId;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string &&
             data.role in ['admin', 'barber'] &&
             (data.createdAt == (resource == null ? request.time : resource.data.createdAt));
    }

    function isValidBarbershop(data) {
      return data.ownerId == request.auth.uid &&
             data.id is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100 &&
             (data.createdAt == (resource == null ? request.time : resource.data.createdAt)) &&
             (!('logoUrl' in data) || data.logoUrl == null || (data.logoUrl is string && data.logoUrl.size() <= 1500000)) &&
             (!('coverUrl' in data) || data.coverUrl == null || (data.coverUrl is string && data.coverUrl.size() <= 1500000)) &&
             (!('tagline' in data) || data.tagline == null || (data.tagline is string && data.tagline.size() <= 120)) &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 1000)) &&
             (!('theme' in data) || data.theme == null || (data.theme is map &&
               (!('primaryColor' in data.theme) || data.theme.primaryColor is string) &&
               (!('whatsapp' in data.theme) || data.theme.whatsapp is string)));
    }

    function isValidBarber(data) {
      return data.barbershopId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.specialties is list &&
             data.active is bool &&
             (data.createdAt == (resource == null ? request.time : resource.data.createdAt)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1500000)) &&
             (!('schedule' in data) || data.schedule is map);
    }

    function isValidService(data) {
      return data.barbershopId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.duration is number && data.duration > 0 &&
             (!('description' in data) || data.description is string) &&
             (data.createdAt == (resource == null ? request.time : resource.data.createdAt));
    }

    function isValidAppointment(data) {
      return data.barbershopId is string &&
             data.serviceId is string &&
             data.barberId is string &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.customerPhone is string && data.customerPhone.size() >= 8 && data.customerPhone.size() <= 20 &&
             data.date is string &&
             data.startTime is string &&
             data.endTime is string &&
             data.totalPrice is number &&
             data.status in ['pending', 'confirmed', 'cancelled', 'completed'] &&
             (data.createdAt == (resource == null ? request.time : resource.data.createdAt));
    }

    // --- Rules ---

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && incoming().uid == existing().uid && 
                   incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'barbershopId', 'role']);
    }

    // Barbershops
    match /barbershops/{barbershopId} {
      allow get: if true; // Public for booking
      allow list: if true; // Public so customers can find shop by slug
      allow create: if isSignedIn() && isValidBarbershop(incoming()) && isValidId(barbershopId);
allow update: if isBarbershopOwner(barbershopId) && incoming().ownerId == existing().ownerId &&
             incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'address', 'phone', 'description', 'logoUrl', 'coverUrl', 'tagline', 'theme']);
      allow delete: if isBarbershopOwner(barbershopId);
    }

    // Barbers
    match /barbershops/{barbershopId}/barbers/{barberId} {
      allow read: if true; // Public for booking
      allow create: if isSignedIn() && (isBarbershopOwner(barbershopId) || isMemberOfShop(barbershopId)) && isValidBarber(incoming());
      allow update: if isSignedIn() && (isBarbershopOwner(barbershopId) || isMemberOfShop(barbershopId)) && isValidBarber(incoming());
      allow delete: if isSignedIn() && (isBarbershopOwner(barbershopId) || isMemberOfShop(barbershopId));
    }

    // Services
    match /barbershops/{barbershopId}/services/{serviceId} {
      allow read: if true; // Public for booking
      allow create: if isSignedIn() && (isBarbershopOwner(barbershopId) || isMemberOfShop(barbershopId)) && isValidService(incoming());
      allow update: if isSignedIn() && (isBarbershopOwner(barbershopId) || isMemberOfShop(barbershopId)) && isValidService(incoming());
      allow delete: if isSignedIn() && (isBarbershopOwner(barbershopId) || isMemberOfShop(barbershopId));
    }

    // Appointments
    match /barbershops/{barbershopId}/appointments/{appointmentId} {
      allow get: if true;
      allow list: if isSignedIn() && (isBarbershopOwner(barbershopId) || isMemberOfShop(barbershopId));
      
      allow create: if isValidAppointment(incoming()) && isValidId(appointmentId);
      
      allow update: if isSignedIn() && (isBarbershopOwner(barbershopId) || isMemberOfShop(barbershopId) || 
                    (incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'cancelled'));
      
      allow delete: if isSignedIn() && (isBarbershopOwner(barbershopId) || isMemberOfShop(barbershopId));
    }

    // Notifications
    match /barbershops/{barbershopId}/notifications/{notificationId} {
      allow read, write: if isBarbershopOwner(barbershopId);
    }

    // Connectivity Test
    match /test/{documentId} {
      allow read, write: if true;
    }
  }
}
